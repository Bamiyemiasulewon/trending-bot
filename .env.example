# Telegram Bot Token (Required)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Network RPC URLs (Required)
BSC_MAINNET_RPC=https://bsc-dataseed.binance.org/

# Wallet Configuration (Required)
WALLET_COUNT=5  # Number of wallets to use for trading
MIN_WALLET_BALANCE=0.01  # Minimum BNB balance before topping up
TOP_UP_AMOUNT=0.05  # Amount of BNB to send when topping up

# Central Wallet (Required for funding)
# WARNING: Never share your private key with anyone
CENTRAL_WALLET_ADDRESS=your_wallet_address_here
CENTRAL_WALLET_PRIVATE_KEY=your_private_key_here

# Trading Parameters
DEFAULT_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000  # Replace with default token address
MIN_TRADE_AMOUNT=0.001  # Minimum BNB amount per trade
MAX_TRADE_AMOUNT=0.005  # Maximum BNB amount per trade
SLIPPAGE=1.0  # 1% slippage tolerance
GAS_PRICE=0  # 0 for automatic gas price

# Trading Intervals (in seconds)
MIN_TRADE_INTERVAL=60  # Minimum time between trades
MAX_TRADE_INTERVAL=300  # Maximum time between trades

# Trading Modes
ENABLE_BUY=true
ENABLE_SELL=true
ENABLE_MASSIVE_BUY=false
ENABLE_GRADUAL_SELL=true

# DEXScreener Settings
MIN_VOLUME_24H=10000  # $10,000
MIN_LIQUIDITY=50000   # $50,000

# Logging
LOG_LEVEL=INFO
