# Network RPC URLs
ETH_MAINNET_RPC=https://eth-mainnet.alchemyapi.io/v2/YOUR_KEY
ETH_SEPOLIA_RPC=https://eth-sepolia.alchemyapi.io/v2/YOUR_KEY
BSC_MAINNET_RPC=https://bsc-dataseed.binance.org
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545
SOLANA_MAINNET_RPC=https://api.mainnet-beta.solana.com
SOLANA_DEVNET_RPC=https://api.devnet.solana.com

# Central Wallet Private Keys (Encrypt in production)
ETH_CENTRAL_WALLET_KEY=your_eth_wallet_private_key
BSC_CENTRAL_WALLET_KEY=your_bsc_wallet_private_key
SOL_CENTRAL_WALLET_KEY=your_solana_wallet_private_key

# Central Wallet Addresses
ETH_CENTRAL_WALLET=0xYourEthereumWalletAddress
BSC_CENTRAL_WALLET=0xYourBSCWalletAddress
SOL_CENTRAL_WALLET=YourSolanaWalletAddress

# Funding Configuration
WALLET_FUND_AMOUNT_ETH=0.0001
WALLET_FUND_AMOUNT_BNB=0.0001
WALLET_FUND_AMOUNT_SOL=0.0001
MAX_WALLETS_PER_CAMPAIGN=100
MIN_WALLETS_PER_CAMPAIGN=50

# Blockchain Confirmations
ETH_CONFIRMATIONS=12
BSC_CONFIRMATIONS=5
SOL_CONFIRMATIONS=1

# API Keys
ALCHEMY_API_KEY=your_alchemy_key
QUICKNODE_API_KEY=your_quicknode_key

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
ADMIN_CHAT_ID=1883549504

# Database
DATABASE_URL=sqlite:///bot.db
