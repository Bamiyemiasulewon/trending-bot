# Network RPC URLs
BSC_MAINNET_RPC=https://bsc-dataseed.binance.org/

# Wallet Configuration
WALLET_COUNT=5
MIN_WALLET_BALANCE=0.01
TOP_UP_AMOUNT=0.05

# Trading Parameters
DEFAULT_TOKEN_ADDRESS=0xYOUR_TOKEN_ADDRESS
MIN_TRADE_AMOUNT=0.001
MAX_TRADE_AMOUNT=0.01
SLIPPAGE=0.5
GAS_PRICE=0  # 0 for automatic

# Trading Intervals (in seconds)
MIN_TRADE_INTERVAL=30
MAX_TRADE_INTERVAL=300

# Trading Modes
ENABLE_BUY=true
ENABLE_SELL=true
ENABLE_MASSIVE_BUY=false
ENABLE_GRADUAL_SELL=true

# DEXScreener Settings
MIN_VOLUME_24H=10000  # $10,000
MIN_LIQUIDITY=50000   # $50,000

# Logging
LOG_LEVEL=INFO
